{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/audit_post_tool_use.py\"",
            "timeout": 15,
            "statusMessage": "Audit event append..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/env_probe.py\"",
            "timeout": 10,
            "statusMessage": "AMO batch-0a env probe (temporary diagnostic)..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/ai_disclosure_rescan.py\"",
            "timeout": 15,
            "statusMessage": "AMO AI-disclosure surface rescan..."
          }
        ]
      }
    ]
  }
}
