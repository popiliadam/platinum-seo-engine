{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://platinum-seo-engine/schemas/monthly-report",
  "title": "Monthly Client Report v1.0",
  "description": "Schema for a per-project monthly stakeholder report, per §22.1 literal. Generated by /platinum-seo-engine:monthly-report on the last business day of the month (§23.3). Data sources feed the 10 required sections (§22.2): GSC 28-day delta, work-log events of types content_new/content_revise/tech_fix/schema_fix/pillar_launch/redirect_deployed, completed_work sheet rows, scrapling S1+S3 outputs, DFS backlinks_new_lost. Framing affects TONE only, never facts (FIX-K K1): the exec narrative always states the net delta (positive or negative) and an optional sections.decliners block lists declining pages/content with byte-identical rows/numbers under both framings; positive_client may order decliners after wins and use constructive tone. Output formats §22.4: html|pdf|notion (multi-select). Sections inline at properties.sections.properties for direct access.",
  "type": "object",
  "required": ["schema_version", "report_id", "project_id", "period_start", "period_end", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_id": {
      "type": "string",
      "description": "Stable id; convention {project_id}-{YYYY-MM}.",
      "pattern": "^[a-z][a-z0-9-]*-[0-9]{4}-[0-9]{2}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "period_start": { "type": "string", "format": "date" },
    "period_end":   { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": {
      "type": "string",
      "description": "Tool id (monthly_report) + optional agent run_id.",
      "default": "monthly_report"
    },
    "sections": {
      "type": "object",
      "description": "The 10 required sections per §22.1 — additive form of §22.2's 8-data-sections + exec_summary and next_month_plan bookends. All 10 are required; an optional 11th `decliners` section (FIX-K K1, additive — NOT in required) carries the framing-invariant declining-pages/content facts.",
      "required": [
        "exec_summary",
        "gsc_positive_trends",
        "keywords_up",
        "pages_up",
        "tech_seo_done",
        "content_revised",
        "new_content",
        "competitor_snapshot",
        "backlink_delta",
        "next_month_plan"
      ],
      "additionalProperties": false,
      "properties": {
        "exec_summary": {
          "type": "object",
          "description": "§22.2 section 1 — auto-generated from headlines of sections 2-7.",
          "required": ["narrative"],
          "properties": {
            "narrative":         { "type": "string", "minLength": 1 },
            "headline_clicks":   { "type": "integer" },
            "headline_pages_up": { "type": "integer" },
            "headline_wins":     { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
          },
          "additionalProperties": false
        },
        "gsc_positive_trends": {
          "type": "object",
          "description": "§22.2 section 2 — 28-day vs prior 28-day totals + deltas. Source: gsc_search_analytics aggregate.",
          "required": ["current_period", "previous_period", "deltas"],
          "properties": {
            "current_period":  { "$ref": "#/definitions/gscTotals" },
            "previous_period": { "$ref": "#/definitions/gscTotals" },
            "deltas": {
              "type": "object",
              "properties": {
                "clicks_delta_pct":      { "type": "number" },
                "impressions_delta_pct": { "type": "number" },
                "ctr_delta_pp":          { "type": "number", "description": "Percentage points (not pct)." },
                "position_delta":        { "type": "number", "description": "Negative = improved." }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "keywords_up": {
          "type": "array",
          "description": "§22.2 section 3 — opportunity-derived keywords (top-20 by clicks). position_before is the stored prior-period position when a longitudinal source supplies it, else null (GAP-M-W2 retired the pos_after+3 fabrication — null is honest 'unknown').",
          "items": {
            "type": "object",
            "required": ["query", "position_before", "position_after"],
            "properties": {
              "query":            { "type": "string" },
              "page":             { "type": "string", "format": "uri" },
              "position_before":  { "type": ["number", "null"], "description": "Prior-period position, or null when no longitudinal source stored it (GAP-M-W2: the retired pos_after+3 fabrication was removed — null is honest 'unknown', never a synthetic delta)." },
              "position_after":   { "type": "number" },
              "impressions_28d":  { "type": "integer", "minimum": 0 },
              "clicks_28d":       { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "pages_up": {
          "type": "array",
          "description": "§22.2 section 4 — pages with clicks or impressions delta gains. Typically top-10.",
          "items": {
            "type": "object",
            "required": ["page", "clicks_delta", "impressions_delta"],
            "properties": {
              "page":              { "type": "string", "format": "uri" },
              "clicks_before":     { "type": "integer", "minimum": 0 },
              "clicks_after":      { "type": "integer", "minimum": 0 },
              "clicks_delta":      { "type": "integer" },
              "impressions_delta": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "tech_seo_done":   { "$ref": "#/definitions/completedArray" },
        "content_revised": { "$ref": "#/definitions/completedArray" },
        "new_content":     { "$ref": "#/definitions/completedArray" },
        "competitor_snapshot": {
          "type": "object",
          "description": "§22.2 section 8 — aggregate of last-month S1 (competitor_snapshot) and S3 (price_monitor) outputs.",
          "properties": {
            "competitors_tracked": { "type": "integer", "minimum": 0 },
            "price_deltas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["competitor_domain", "product_url", "delta_pct"],
                "properties": {
                  "competitor_domain": { "type": "string" },
                  "product_url":       { "type": "string", "format": "uri" },
                  "price_before":      { "type": "number" },
                  "price_after":       { "type": "number" },
                  "currency":          { "type": "string", "description": "ISO 4217" },
                  "delta_pct":         { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "new_pages_detected": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["competitor_domain", "page_url"],
                "properties": {
                  "competitor_domain": { "type": "string" },
                  "page_url":          { "type": "string", "format": "uri" },
                  "page_type":         { "type": "string" },
                  "detected_at":       { "type": "string", "format": "date-time" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "backlink_delta": {
          "type": "object",
          "description": "§22.2 section 9 — new vs lost vs toxic backlinks (DFS backlinks_new_lost).",
          "properties": {
            "new_count":   { "type": "integer", "minimum": 0 },
            "lost_count":  { "type": "integer", "minimum": 0 },
            "toxic_count": { "type": "integer", "minimum": 0 },
            "top_new":  { "type": "array", "items": { "type": "object" }, "maxItems": 10 },
            "top_lost": { "type": "array", "items": { "type": "object" }, "maxItems": 10 }
          },
          "additionalProperties": false
        },
        "next_month_plan": {
          "type": "array",
          "description": "§22.2 section 10 — priority-sorted top-10 TODO from master_task.",
          "items": {
            "type": "object",
            "required": ["task_id", "priority"],
            "properties": {
              "task_id":          { "type": "string", "pattern": "^T-[0-9]{4,}$" },
              "priority":         { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "task":             { "type": "string" },
              "url":              { "type": "string", "format": "uri" },
              "duration_est_min": { "type": "integer", "minimum": 1 },
              "impact":           { "type": "string" }
            },
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "decliners": {
          "type": "object",
          "description": "FIX-K K1(b) — declining keywords/pages (\"Düşenler\"). Additive OPTIONAL section (NOT in sections.required). Present in BOTH framings with byte-identical rows/numbers; positive_client may order it after wins and use constructive tone, but never alters these facts.",
          "properties": {
            "net_clicks_delta_pct": { "type": "number", "description": "Signed net clicks delta % — the headline fact, stated identically in both framings." },
            "pages_down": {
              "type": "array",
              "description": "Pages with negative clicks or impressions delta (mirror of pages_up). Source: gsc_performance.",
              "items": {
                "type": "object",
                "required": ["page", "clicks_delta"],
                "properties": {
                  "page":              { "type": "string", "format": "uri" },
                  "clicks_before":     { "type": "integer", "minimum": 0 },
                  "clicks_after":      { "type": "integer", "minimum": 0 },
                  "clicks_delta":      { "type": "integer" },
                  "impressions_delta": { "type": "integer" }
                },
                "additionalProperties": false
              }
            },
            "decaying_content": {
              "type": "array",
              "description": "content_decay sheet rows (R-85) with negative clicks_delta; pillar-tagged.",
              "items": {
                "type": "object",
                "required": ["page", "clicks_delta"],
                "properties": {
                  "page":          { "type": "string", "format": "uri" },
                  "clicks_before": { "type": "integer", "minimum": 0 },
                  "clicks_after":  { "type": "integer", "minimum": 0 },
                  "clicks_delta":  { "type": "integer" },
                  "pillar":        { "type": "string" },
                  "trend":         { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "measurement_context": {
          "type": "object",
          "description": "GAP-M-W2 (R-137 core-update overlap + R-138 intervention outcomes) — measurement-honesty annotation. Additive OPTIONAL section (NOT in sections.required). Framing-INVARIANT: built identically under both framings (the builder takes no framing_policy). measurement_quality flags whether period deltas are attributable; core_updates_overlap annotates Google Search Ranking-update windows (incl. 7-day settling buffer); intervention_outcomes carries treated-vs-control quick-win verdicts (difference in pp, n<30 directional caveat).",
          "properties": {
            "measurement_quality": {
              "enum": ["clean", "update_overlap", "post_update_settling", "insufficient_history"],
              "description": "clean = no Ranking-update overlap; update_overlap = window overlaps an active rollout; post_update_settling = within the 7-day settle buffer after rollout end; insufficient_history = no calendar loaded (overlap undeterminable, never asserted clean)."
            },
            "core_updates_overlap": {
              "type": "array",
              "description": "Google Search Ranking updates overlapping the report window (R-137). Source: update_calendar.overlaps().",
              "items": {
                "type": "object",
                "required": ["name", "phase"],
                "properties": {
                  "id":           { "type": ["string", "null"] },
                  "name":         { "type": ["string", "null"] },
                  "begin":        { "type": ["string", "null"] },
                  "end":          { "type": ["string", "null"] },
                  "overlap_days": { "type": "integer", "minimum": 0 },
                  "phase":        { "enum": ["rolling", "rollout_in_period", "settling"] }
                },
                "additionalProperties": false
              }
            },
            "intervention_outcomes": {
              "type": "array",
              "description": "Treated-vs-control quick-win outcomes (R-138) from scripts/reporting/intervention_outcome.py — reported as the treated−control difference in pp, never a raw treated delta; n<30 directional caveat; no p-values.",
              "items": {
                "type": "object",
                "properties": {
                  "cohort_date":   { "type": "string" },
                  "score_version": { "type": "string" },
                  "post_date":     { "type": "string" },
                  "difference_pp": { "type": "number" },
                  "verdict":       { "enum": ["engine_positive", "engine_negative", "indistinguishable"] },
                  "caveat":        { "type": "string" },
                  "treated":       { "type": "object" },
                  "control":       { "type": "object" },
                  "attrition":     { "type": "object" }
                },
                "additionalProperties": false
              }
            },
            "notes": { "type": "string", "description": "One-line framing-invariant attribution verdict." }
          },
          "additionalProperties": false
        }
      }
    },
    "output_formats": {
      "type": "array",
      "description": "§22.4 — which render targets produced output artifacts in this run.",
      "items": { "enum": ["html", "pdf", "notion"] },
      "uniqueItems": true,
      "minItems": 1
    },
    "artifacts": {
      "type": "object",
      "description": "Relative paths to the rendered artifacts per format. Keys must be a subset of output_formats.",
      "properties": {
        "html":   { "type": "string" },
        "pdf":    { "type": "string" },
        "notion": { "type": "string", "description": "Notion page URL or page_id." }
      },
      "additionalProperties": false
    },
    "data_sources": {
      "type": "array",
      "description": "Provenance — which run_ids fed this report. Links monthly report ↔ provenance log.",
      "items": {
        "type": "object",
        "required": ["source", "run_ids"],
        "properties": {
          "source":  { "enum": ["gsc_mcp", "dataforseo_mcp", "scrapling_local", "scrapling_mcp", "work_log", "master_task", "completed_work"] },
          "run_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        },
        "additionalProperties": false
      }
    },
    "framing_policy": {
      "type": "string",
      "description": "§22.3 — positive_client is the default framing (TONE only). Per FIX-K K1 facts are framing-invariant: the net delta and sections.decliners appear under BOTH framings with identical numbers; positive_client only orders/softens presentation. 'internal' may foreground declines.",
      "enum": ["positive_client", "internal"],
      "default": "positive_client"
    }
  },
  "definitions": {
    "gscTotals": {
      "type": "object",
      "properties": {
        "clicks":      { "type": "integer", "minimum": 0 },
        "impressions": { "type": "integer", "minimum": 0 },
        "ctr":         { "type": "number", "minimum": 0, "maximum": 1 },
        "avg_position":{ "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "completedArray": {
      "type": "array",
      "description": "Reusable shape for sections 5/6/7 (tech_seo_done, content_revised, new_content).",
      "items": {
        "type": "object",
        "required": ["task_id", "completion_date"],
        "properties": {
          "task_id":          { "type": "string", "pattern": "^T-[0-9]{4,}$" },
          "url":              { "type": "string", "format": "uri" },
          "title":            { "type": "string" },
          "completion_date":  { "type": "string", "format": "date" },
          "work_log_ref":     { "type": "string" },
          "metric_impact":    { "type": "object" },
          "pillar":           { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
