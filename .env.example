# Google Search Console — Service Account JSON path
# Generate at: https://console.cloud.google.com → IAM → Service Accounts
# Env var name = paket-spec direct (Google Cloud SDK standardı)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-indexing-sa.json

# DataForSEO API credentials (https://app.dataforseo.com → API tab)
DATAFORSEO_USERNAME=your-dataforseo-email
DATAFORSEO_PASSWORD=your-dataforseo-password

# Scrapling binary path (default: 'scrapling' in PATH)
# Install: pip install scrapling[fetchers] && scrapling install
SCRAPLING_BIN=scrapling

# Workspace root path — resolve projects/{slug}/ (used by scripts via PSEO_WORKSPACE_ROOT)
PSE_WORKSPACE_PATH=~/Documents/platinum-seo-workspace

# Higgsfield AI credentials — generate-images skill (Phase 11+)
# Obtain at: https://app.higgsfield.ai → Settings → API Keys
HIGGSFIELD_API_KEY=your-higgsfield-api-key
