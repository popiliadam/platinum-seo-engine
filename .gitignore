# ─────────────────────────────────────────────
# Platinum SEO Engine — .gitignore
# ─────────────────────────────────────────────

# ─── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.cover
.hypothesis/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ─── Node / JS ────────────────────────────────
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml

# ─── Build / dist ─────────────────────────────
dist/
build/
out/
*.tgz
*.tar.gz

# ─── macOS ────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.fseventsd
.TemporaryItems

# ─── Windows ──────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace

# ─── Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
secrets/
.secrets/

# ─── Workspace runtime artifacts ──────────────
# (plugin repo MUST NOT contain runtime state — bunlar workspace tarafında oluşur)
outputs/
inbox/
state/events.jsonl
state/snapshots/
state/runs/

# ─── Excel runtime ────────────────────────────
# Tüm xlsx dosyalarını ignore et, sadece master template'e izin ver
*.xlsx
*.xlsm
*.xlsb
*.xls
~$*.xlsx
!templates/master-excel.xlsx

# ─── Misc temp ────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*.rej
.cache/
